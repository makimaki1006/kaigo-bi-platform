# ============================================
# kaigo-bi-backend 環境変数テンプレート
# コピーして .env を作成し、実際の値を設定する
# ============================================

# Turso (LibSQL) メインDB
TURSO_DATABASE_URL=libsql://your-db.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=

# Turso 外部統計DB（オプション）
EXTERNAL_DB_URL=libsql://your-external-db.aws-ap-northeast-1.turso.io
EXTERNAL_DB_TOKEN=

# アプリケーション設定
KAIGO_PORT=3001

# JWT認証（本番では必ずランダムな長い文字列に変更）
JWT_SECRET=change-me-in-production

# ============================================
# Stripe課金（SaaS Phase 1で追加）
# ============================================
# Stripeダッシュボード > 開発者 > APIキー
STRIPE_SECRET_KEY=sk_test_...
# Stripeダッシュボード > 開発者 > Webhook > 署名シークレット
# ローカル開発: stripe listen --forward-to localhost:3001/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
# 各プランのPrice ID（Stripeダッシュボード > 商品カタログで作成）
# ⚠️ Managed Payments有効のアカウントでは商品に tax_code が必須
#    SaaSは txcd_10103000 を設定すること（未設定だとCheckout作成が失敗する）
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_MA=price_...

# フロントエンドURL（Checkout成功/キャンセル時のリダイレクト先）
APP_URL=http://localhost:3000
